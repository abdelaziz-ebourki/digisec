#DIGISEC deployment configuration.
#Copy to .env and fill in real values before running docker compose up.

# --- Database ---
#DB_ROOT_PASSWORD=change-me-root
#DB_NAME=digisec
#DB_USERNAME=digisec
#DB_PASSWORD=change-me-db

# --- Security (REQUIRED, 32+ random characters) ---
# Generate with: openssl rand -base64 48
#JWT_SECRET=

# --- Outgoing mail (verification emails) ---
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=

# --- Public URL used inside verification links ---
#FRONTEND_URL=http://localhost

# --- Initial admin account (created once at first boot) ---
#SEED_ADMIN=true
#ADMIN_EMAIL=admin@digisec.local
#ADMIN_PASSWORD=change-me-admin

# --- Web port binding ---
#WEB_PORT=80
